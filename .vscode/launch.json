{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rankstack API (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "module": "uvicorn",
      "args": ["api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}\\.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Rankstack Web (Next.js)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/app",
      "serverReadyAction": {
        "pattern": "- Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "Rankstack: Full Stack",
      "configurations": ["Rankstack API (FastAPI)", "Rankstack Web (Next.js)"],
      "preLaunchTask": "Rankstack: Start infrastructure",
      "stopAll": true
    }
  ]
}
