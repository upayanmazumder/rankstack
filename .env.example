# Copy to .env and adjust if needed. Never commit the real .env.

# MongoDB (single-node replica set, required for multi-document transactions)
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB=rankstack

# Redis (leaderboard sorted sets, sessions, rate limiting)
REDIS_URI=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed browser origins (frontend URL(s))
CORS_ORIGINS=http://localhost:3000

# Session / rate-limit tuning
SESSION_TTL_SECONDS=3600
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_SUBMISSIONS=10
